{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crab Control",
  "version": "0.1.1",
  "identifier": "com.crabcontrol.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crab Control",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0QzM0NDFCRjZGQjM1NDUKUldSRk5mdjJHMFRESlBocXZzZlFBcXBSL1RHUE5aTlVmRjY5TGtZeTEvNDNRNFUyMXNZYmhiNUEK",
      "endpoints": [
        "https://github.com/0xLeathery/crab-control/releases/latest/download/latest.json"
      ]
    }
  }
}
